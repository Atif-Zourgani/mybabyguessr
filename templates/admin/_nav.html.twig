{% set _cur = app.request.attributes.get('_route') %}
{% set _loc = app.request.locale %}
{% set _items = [
    {route: 'app_admin_index',      label: 'Vue d\'ensemble', also: []},
    {route: 'app_admin_users',      label: 'Utilisateurs',    also: ['app_admin_user_show']},
    {route: 'app_admin_games',      label: 'Jeux',            also: []},
    {route: 'app_admin_moderation', label: 'Modération',      also: []},
    {route: 'app_admin_logs',       label: 'Activité',        also: []},
    {route: 'app_admin_security',   label: 'Sécurité',        also: []},
] %}

<nav class="adm-nav" aria-label="Administration">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="adm-nav-inner">
            {% for item in _items %}
            <a href="{{ path(item.route, {'_locale': _loc}) }}"{% if _cur == item.route or _cur in item.also %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </div>
    </div>
</nav>
