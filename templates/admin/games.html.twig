{% extends 'admin/base.html.twig' %}
{% block title %}Admin — Jeux — MyBabyGuessr{% endblock %}

{% block admin_content %}
{% import 'admin/_macros.html.twig' as adm %}
{% set _return = app.request.requestUri %}

    <div class="adm-head">
        <div>
            <h1 class="adm-title">Jeux</h1>
            <p class="adm-subtitle">Tous les Baby Guessr créés</p>
        </div>
    </div>

    <div class="adm-stats">
        <div class="card adm-stat"><div class="adm-stat-value">{{ gamesByStatus.open ?? 0 }}</div><div class="adm-stat-label">Ouverts</div></div>
        <div class="card adm-stat"><div class="adm-stat-value" style="color:#6b7280">{{ gamesByStatus.closed ?? 0 }}</div><div class="adm-stat-label">Fermés</div></div>
        <div class="card adm-stat"><div class="adm-stat-value" style="color:#276749">{{ gamesByStatus.revealed ?? 0 }}</div><div class="adm-stat-label">Révélés</div></div>
        <div class="card adm-stat"><div class="adm-stat-value" style="color:#b42318">{{ hiddenGames }}</div><div class="adm-stat-label">Masqués</div></div>
        <div class="card adm-stat"><div class="adm-stat-value">{{ totalGuesses }}</div><div class="adm-stat-label">Participations</div></div>
        <div class="card adm-stat"><div class="adm-stat-value">{{ avgGuesses }}</div><div class="adm-stat-label">Moy. par jeu</div></div>
    </div>

    {% if catStats is not empty and totalGames > 0 %}
    <div class="card adm-section" style="padding:1.25rem 1.5rem">
        <div class="adm-section-title">Catégories activées</div>
        {% set cats = [
            {label: 'Sexe',   count: catStats.gender},
            {label: 'Prénom', count: catStats.name},
            {label: 'Date',   count: catStats.date_cat},
            {label: 'Poids',  count: catStats.weight},
            {label: 'Taille', count: catStats.height},
        ] %}
        <div class="adm-cats">
            {% for cat in cats %}
            {% set pct = ((cat.count / totalGames) * 100)|round %}
            <div style="text-align:center">
                <div style="font-size:1.125rem;font-weight:800;color:var(--color-brand)">{{ cat.count ?? 0 }}</div>
                <div style="height:6px;background:var(--color-line);border-radius:3px;margin:.375rem 0"><div style="height:6px;background:var(--color-brand);border-radius:3px;width:{{ pct }}%;opacity:.7"></div></div>
                <div class="adm-cell-sub">{{ cat.label }} · {{ pct }}%</div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <form class="adm-toolbar" method="get" action="{{ path('app_admin_games', {'_locale': app.request.locale}) }}" role="search">
        <div class="adm-field adm-field--grow">
            <label for="f-q">Recherche</label>
            <input id="f-q" type="search" name="q" value="{{ filters.q }}" placeholder="Titre, créateur ou email" autocomplete="off">
        </div>
        <div class="adm-field">
            <label for="f-status">Statut</label>
            <select id="f-status" name="status">
                <option value="">Tous</option>
                <option value="open" {{ filters.status == 'open' ? 'selected' }}>Ouverts</option>
                <option value="closed" {{ filters.status == 'closed' ? 'selected' }}>Fermés</option>
                <option value="revealed" {{ filters.status == 'revealed' ? 'selected' }}>Révélés</option>
            </select>
        </div>
        <div class="adm-field">
            <label for="f-vis">Visibilité</label>
            <select id="f-vis" name="visibility">
                <option value="">Tous</option>
                <option value="visible" {{ filters.visibility == 'visible' ? 'selected' }}>Visibles</option>
                <option value="hidden" {{ filters.visibility == 'hidden' ? 'selected' }}>Masqués</option>
            </select>
        </div>
        <div class="adm-field">
            <label for="f-sort">Trier par</label>
            <select id="f-sort" name="sort">
                {% for key, label in {created: 'Création', title: 'Titre', owner: 'Créateur', status: 'Statut', guesses: 'Participations'} %}
                <option value="{{ key }}" {{ filters.sort == key ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="adm-field">
            <label for="f-dir">Ordre</label>
            <select id="f-dir" name="dir">
                <option value="desc" {{ filters.dir != 'asc' ? 'selected' }}>Décroissant</option>
                <option value="asc" {{ filters.dir == 'asc' ? 'selected' }}>Croissant</option>
            </select>
        </div>
        <button type="submit" class="adm-btn adm-btn--primary">Filtrer</button>
        <a class="adm-btn" href="{{ path('app_admin_games', {'_locale': app.request.locale}) }}">Réinitialiser</a>
    </form>

    <div class="card" style="padding:0;overflow:hidden">
        {% include 'admin/_games_table.html.twig' with {page: page, filters: filters, return: _return, showOwner: true} only %}
        {{ adm.pager(page) }}
    </div>
{% endblock %}
